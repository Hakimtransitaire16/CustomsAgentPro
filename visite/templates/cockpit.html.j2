{%- set dec = d.declaration -%}{%- set tr = d.transport -%}{%- set vis = d.visite or {} -%}
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Dossier de visite — {{ d.meta.produit_titre or d.articles[0].designation }}</title>
<style>
:root{--ink:#0E1A2B;--ink2:#3A4656;--muted:#6B7685;--line:#DCE1E8;--navy:#0F2D4F;--blue:#2C66A8;--blue-l:#E8F0F9;--ok:#1D7A4C;--ok-l:#E7F4EC;--warn:#A8660B;--warn-l:#FBF1E1;--crit:#B3261E;--crit-l:#FBE9E7;--bg:#F3F5F8;--card:#fff;--bar:#0F2D4F}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--ink:#E8EDF3;--ink2:#C3CCD7;--muted:#9AA6B4;--line:#2A3646;--navy:#9FC0E6;--blue:#6FA3E0;--blue-l:#1A2A3D;--ok:#5CC48C;--ok-l:#173025;--warn:#E0A84E;--warn-l:#33281A;--crit:#F08A80;--crit-l:#3A1C1A;--bg:#0D141D;--card:#151F2B;--bar:#0B1E33}}
:root[data-theme="dark"]{--ink:#E8EDF3;--ink2:#C3CCD7;--muted:#9AA6B4;--line:#2A3646;--navy:#9FC0E6;--blue:#6FA3E0;--blue-l:#1A2A3D;--ok:#5CC48C;--ok-l:#173025;--warn:#E0A84E;--warn-l:#33281A;--crit:#F08A80;--crit-l:#3A1C1A;--bg:#0D141D;--card:#151F2B;--bar:#0B1E33}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.45 -apple-system,"Segoe UI",Inter,Roboto,sans-serif;-webkit-text-size-adjust:100%}
.top{background:var(--bar);color:#fff;padding:14px 16px 0;position:sticky;top:0;z-index:20}
.top .row{display:flex;align-items:center;gap:12px;max-width:1100px;margin:0 auto}
.mono{width:38px;height:38px;flex:none;background:#fff;color:#0F2D4F;font-weight:800;display:flex;align-items:center;justify-content:center;font-size:13px;letter-spacing:.04em}
.top .k{font-size:10.5px;letter-spacing:.16em;color:#9FC0E6;font-weight:700}
.top h1{font-size:18px;margin:1px 0 0;line-height:1.2}
.top .refs{font:12px ui-monospace,monospace;color:#C9D6E5;margin-top:3px;word-break:break-all}
.chips{display:flex;gap:6px;flex-wrap:wrap;max-width:1100px;margin:10px auto 0}
.chip{font-size:11.5px;font-weight:700;padding:3px 9px;border-radius:999px;background:rgba(255,255,255,.1);color:#fff;white-space:nowrap}
.chip.r{background:#B3261E}.chip.g{background:#1D7A4C}
nav.tabs{display:flex;gap:2px;max-width:1100px;margin:12px auto 0;overflow-x:auto;scrollbar-width:none}
nav.tabs button{flex:none;background:none;border:0;color:#C9D6E5;font:600 14px inherit;padding:10px 14px;border-bottom:3px solid transparent;cursor:pointer;font-family:inherit}
nav.tabs button[aria-selected="true"]{color:#fff;border-bottom-color:#6FA3E0}
main{max-width:1100px;margin:0 auto;padding:14px 16px 110px}
section.tab{display:none}section.tab.on{display:block}
.priv{border-left:4px solid var(--crit,#b42318)}.pw{color:var(--crit,#b42318);font-weight:600;margin:0 0 10px}
.note h2{font-size:15px;margin:18px 0 6px}.note p,.note li{font-size:13.5px;line-height:1.5}.note pre{white-space:pre-wrap;font-size:12px;background:#f3f5f8;padding:10px;border-radius:6px;overflow-x:auto}
@media print{ section#t-note{display:none!important}}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px;margin-bottom:12px}
h2{font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--navy);margin:0 0 10px}
.tool{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
.btn{padding:11px 14px;font:700 14px inherit;border-radius:10px;border:0;background:#0F2D4F;color:#fff;cursor:pointer;font-family:inherit}
.btn.s{background:var(--blue-l);color:var(--navy)}
.paper{background:#7d8794;border-radius:12px;padding:10px;overflow:hidden}
.paper .wrap{transform-origin:0 0;width:794px}
.paper iframe{width:794px;border:0;display:block;background:#7d8794}
.kv{display:grid;grid-template-columns:auto 1fr;gap:6px 12px;font-size:14px}.kv b{font-family:ui-monospace,monospace;word-break:break-all}.kv span{color:var(--muted)}
label.ck{display:flex;gap:12px;align-items:flex-start;padding:10px 0;border-bottom:1px solid var(--line);font-size:14px}label.ck:last-child{border:none}
label.ck input{width:24px;height:24px;flex:none;accent-color:var(--ok);margin:0}
.cnt{display:grid;grid-template-columns:1fr 92px 84px;gap:8px;align-items:center;padding:8px 0;border-bottom:1px solid var(--line);font-size:14px}
input,select,textarea{width:100%;padding:10px;font-size:16px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink);font-family:inherit}
.st{font-size:12px;font-weight:700;text-align:center;border-radius:6px;padding:6px 4px}.st.ok{background:var(--ok-l);color:var(--ok)}.st.ko{background:var(--crit-l);color:var(--crit)}.st.na{color:var(--muted)}
.ph{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
@media (min-width:760px){.ph{grid-template-columns:repeat(4,1fr)}}
.slot{border:1.5px dashed var(--line);border-radius:10px;overflow:hidden;position:relative;aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;text-align:center;font-size:12px;color:var(--muted);padding:6px;background:var(--bg)}
.slot img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.slot input{position:absolute;inset:0;opacity:0;padding:0}
.slot .cap{position:absolute;left:0;right:0;bottom:0;background:rgba(15,45,79,.85);color:#fff;font-size:11px;padding:4px 6px}
.f{margin-bottom:10px}.f label{display:block;font-size:12px;color:var(--muted);margin-bottom:4px;font-weight:600}
.prog{height:6px;background:var(--line);border-radius:3px;margin:4px 0 2px}.prog i{display:block;height:100%;width:0;background:var(--ok);border-radius:3px;transition:width .2s}
.ctl{display:grid;grid-template-columns:28px 1fr;gap:10px;padding:10px 0;border-bottom:1px solid var(--line)}.ctl:last-child{border:none}
.ic{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px}
.ic.ok{background:var(--ok-l);color:var(--ok)}.ic.alerte{background:var(--warn-l);color:var(--warn)}.ic.erreur{background:var(--crit-l);color:var(--crit)}
.ctl b{display:block;font-size:14px}.ctl small{color:var(--muted);font-size:12.5px;font-variant-numeric:tabular-nums}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:12px}
.kpi{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px}.kpi .l{font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;font-weight:600}.kpi .v{font-size:21px;font-weight:800;color:var(--navy);font-variant-numeric:tabular-nums}.kpi .v small{font-size:11px;color:var(--muted)}
.tbl{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:13px;font-variant-numeric:tabular-nums}th{text-align:left;font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;padding:8px;border-bottom:2px solid var(--navy);white-space:nowrap}td{padding:8px;border-bottom:1px solid var(--line);vertical-align:top}td.n{text-align:right;white-space:nowrap}
.m{font-family:ui-monospace,monospace;font-size:12px}
pre{background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:10px;font-size:11.5px;max-height:60vh;overflow:auto;white-space:pre-wrap;word-break:break-word}
.who{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.who div{flex:1;min-width:110px;background:var(--bg);border-radius:8px;padding:8px}.who small{display:block;color:var(--muted);font-size:11px}
.dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}
.dl button{text-align:left;padding:14px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--ink);cursor:pointer;font-family:inherit}
.dl button b{display:block;font-size:14px;color:var(--navy)}.dl button small{color:var(--muted)}
@media (max-width:760px){nav.tabs{position:fixed;left:0;right:0;bottom:0;margin:0;background:var(--bar);justify-content:space-around;padding:0 4px env(safe-area-inset-bottom);z-index:30}
  nav.tabs button{font-size:12px;padding:12px 6px;border-bottom:0;border-top:3px solid transparent;flex:1}nav.tabs button[aria-selected="true"]{border-top-color:#6FA3E0}
  .top{padding-bottom:12px}.cnt{grid-template-columns:1fr 80px 78px}}
</style>
</head>
<body>
<div class="top">
  <div class="row"><div class="mono">{{ d.meta.declarant.nom.split()[0][0] }}{{ d.meta.declarant.nom.split()[1][0] if d.meta.declarant.nom.split()|length > 1 else '' }}</div>
    <div style="min-width:0"><div class="k">DOSSIER DE VISITE · {{ (vis.lieu or '')|upper }}</div><h1>{{ d.meta.produit_titre or d.articles[0].designation }} {{ d.meta.produit_sous_titre or '' }}</h1>
    <div class="refs">D10 {{ dec.numero }} · MRN {{ dec.mrn }} · {{ tr.conteneur }}</div></div></div>
  <div class="chips"><span class="chip {{ 'r' if dec.circuit == 'rouge' else 'g' }}">Circuit {{ dec.circuit }}</span>
    {% if not partage %}<span class="chip">Contrôles ✓ {{ resume.ok }} · ! {{ resume.alerte }} · ✕ {{ resume.erreur }}</span>{% endif %}
    {% if fid %}<span class="chip">Fidélité {{ fid_ok }}/{{ fid|length }}</span>{% endif %}
    <span class="chip" id="chipVis">Visite 0 %</span></div>
  <nav class="tabs" role="tablist">
    {% for id, lab in ([('fiche','Fiche'), ('visite','Visite')] if partage else [('fiche','Fiche'), ('visite','Visite'), ('controles','Contrôles'), ('registre','Registre'), ('donnees','Données')] + ([('note','Note privée')] if note_html else [])) %}
    <button role="tab" data-tab="{{ id }}" aria-selected="{{ 'true' if loop.first else 'false' }}">{{ lab }}</button>{% endfor %}
  </nav>
</div>

<main>
<!-- ============ FICHE ============ -->
<section class="tab on" id="t-fiche">
  <div class="tool"><button class="btn" id="print">Imprimer / enregistrer en PDF</button><button class="btn s" id="open">Ouvrir la fiche seule</button></div>
  <div class="paper"><div class="wrap" id="wrap"><iframe id="fiche" title="Fiche technique" srcdoc="{{ fiche|e }}"></iframe></div></div>
</section>

<!-- ============ VISITE ============ -->
<section class="tab" id="t-visite">
  <div class="card"><h2>Références</h2>
    <div class="kv"><span>Conteneur</span><b>{{ tr.conteneur }}</b><span>Scellé</span><b>{{ tr.scelle }}</b><span>Colis</span><b>{{ dec.nb_colis }}</b>
    <span>Poids brut</span><b>{{ dec.poids_brut|n }} kg</b><span>Origine</span><b>{{ d.origine.pays }} ({{ d.origine.code }})</b><span>Lieu</span><b>{{ vis.lieu }}</b></div>
    <div class="who"><div><small>Inspecteur</small>{{ vis.inspecteur }}</div><div><small>Agent</small>{{ vis.agent }}</div><div><small>Déclarant</small>{{ d.meta.declarant.nom }}</div></div>
  </div>
  <div class="card"><h2>Check-list</h2><div class="prog"><i id="prog"></i></div>
    {% for x in checklist %}<label class="ck"><input type="checkbox" data-k="ck{{ loop.index }}"><span>{{ x }}</span></label>{% endfor %}</div>
  <div class="card"><h2>Comptage</h2>
    {% for lab, att in comptages %}<div class="cnt"><span>{{ lab }} · <b>{{ att }}</b></span><input inputmode="numeric" data-k="cnt{{ loop.index }}" data-att="{{ att }}" aria-label="Compté : {{ lab }}"><span class="st na">—</span></div>{% endfor %}</div>
  <div class="card"><h2>Photos</h2>
    <div class="ph">{% for p in slots %}<div class="slot" data-i="{{ loop.index0 }}"><span>📷 {{ p }}</span><input type="file" accept="image/*" capture="environment" aria-label="{{ p }}"><div class="cap">{{ p }}</div></div>{% endfor %}</div></div>
  <div class="card"><h2>Procès-verbal — s'inscrit dans la fiche</h2>
    <div class="f"><label>Date et heure de la visite</label><input type="datetime-local" data-k="date" data-pv="date"></div>
    <div class="f"><label>État du scellé {{ tr.scelle }}</label><select data-k="scelle" data-pv="scelle"><option value="">—</option><option>Intact, conforme au B/L</option><option>Rompu</option><option>Non conforme au B/L</option></select></div>
    <div class="f"><label>Colis / unités comptés</label><input type="text" data-k="comptage" data-pv="comptage"></div>
    <div class="f"><label>Marquages et étiquettes</label><input type="text" data-k="etiquettes" data-pv="etiquettes"></div>
    <div class="f"><label>Pesée de contrôle</label><input type="text" data-k="pesee" data-pv="pesee"></div>
    <div class="f"><label>Échantillons prélevés</label><input type="text" data-k="echantillons" data-pv="echantillons"></div>
    <div class="f"><label>Observations</label><textarea rows="3" data-k="observations" data-pv="observations"></textarea></div>
    <div class="tool" style="margin:6px 0 0"><button class="btn" data-go="fiche">Voir la fiche remplie</button><button class="btn s" id="reset">Effacer la visite</button></div>
  </div>
</section>

{% if not partage %}<!-- ============ CONTRÔLES ============ -->
<section class="tab" id="t-controles">
  <div class="kpis"><div class="kpi"><div class="l">Conformes</div><div class="v" style="color:var(--ok)">{{ resume.ok }}</div></div>
    <div class="kpi"><div class="l">Alertes</div><div class="v" style="color:var(--warn)">{{ resume.alerte }}</div></div>
    <div class="kpi"><div class="l">Erreurs</div><div class="v" style="color:var(--crit)">{{ resume.erreur }}</div></div>
    {% if fid %}<div class="kpi"><div class="l">Fidélité aux scans</div><div class="v">{{ fid_ok }}<small> / {{ fid|length }}</small></div></div>{% endif %}</div>
  <div class="card"><h2>Contrôles automatiques</h2>
    {% for c in ctrls %}<div class="ctl"><div class="ic {{ c.statut }}">{{ {'ok':'✓','alerte':'!','erreur':'✕'}[c.statut] }}</div><div><b>{{ c.id }} · {{ c.titre }}</b><small>{{ c.detail }}</small></div></div>{% endfor %}</div>
  {% if fid %}<div class="card"><h2>Fidélité : fiche ↔ images scannées</h2><div class="tbl"><table><tr><th>Donnée</th><th>Valeur</th><th>Résultat</th></tr>
    {% for f in fid %}<tr><td>{{ f.label }}</td><td class="m">{{ f.valeur }}</td><td>{{ '✓ identique' if f.score >= 0.95 else '◎ visuel' }}</td></tr>{% endfor %}</table></div></div>{% endif %}
</section>

<!-- ============ REGISTRE ============ -->
<section class="tab" id="t-registre">
  <div class="kpis">
    <div class="kpi"><div class="l">Dossiers</div><div class="v">{{ kpi.dossiers }}</div></div>
    <div class="kpi"><div class="l">Valeur en douane</div><div class="v">{{ kpi.valeur|n }} <small>DA</small></div></div>
    <div class="kpi"><div class="l">Droits et taxes</div><div class="v">{{ kpi.droits|n }} <small>DA</small></div></div>
    <div class="kpi"><div class="l">Pression fiscale</div><div class="v">{{ kpi.pression|n(1) }} <small>%</small></div></div>
    <div class="kpi"><div class="l">Circuit rouge</div><div class="v">{{ kpi.rouge|n }} <small>%</small></div></div>
    <div class="kpi"><div class="l">Délai accostage → D10</div><div class="v">{{ kpi.delai|n(1) }} <small>j</small></div></div>
  </div>
  <div class="card"><h2>Dossiers</h2><div class="tbl"><table><tr><th>Date D10</th><th>D10 / MRN</th><th>Importateur</th><th>Origine</th><th>Codes SH</th><th>Valeur DA</th><th>Droits DA</th><th>Circuit</th><th>Délai</th><th>Contrôles</th></tr>
    {% for r in rows %}<tr><td>{{ r.date_d10 }}</td><td class="m">{{ r.d10 }}<br>{{ r.mrn }}</td><td>{{ r.importateur }}</td><td>{{ r.origine }}</td><td class="m">{{ r.codes_sh }}</td><td class="n">{{ r.valeur_da|n }}</td><td class="n">{{ r.droits_da|n }}</td><td>{{ r.circuit }}</td><td class="n">{{ r.delai_accostage_d10 }} j</td><td class="n">✓{{ r.controles_ok }} !{{ r.controles_alerte }} ✕{{ r.controles_erreur }}</td></tr>{% endfor %}</table></div></div>
</section>

<!-- ============ DONNÉES ============ -->
<section class="tab" id="t-donnees">
  <div class="dl card">
    <button data-dl="dossier"><b>Dossier JSON</b><small>source unique · relu par le moteur Python</small></button>
    <button data-dl="csv"><b>Registre CSV</b><small>Excel · Power BI</small></button>
    <button data-dl="visite"><b>Visite JSON</b><small>PV, comptages, photos → commande « pv »</small></button>
    <button data-dl="fiche"><b>Fiche HTML</b><small>avec le PV saisi · imprimable</small></button>
  </div>
  <div class="card"><h2>Dossier JSON</h2><pre>{{ dossier_pretty|e }}</pre></div>
</section>

{% endif %}
<!-- ============ NOTE PRIVÉE (déclarant seul) ============ -->
{% if note_html %}<section class="tab" id="t-note">
  <div class="card priv"><h2>Note de risques — déclarant seul</h2>
    <p class="pw">Ne pas montrer à l'inspecteur. Cette note n'est jamais imprimée avec la fiche.</p>
    <button class="btn" id="showNote">Afficher la note</button>
    <div id="noteBody" class="note" hidden>{{ note_html }}</div></div>
</section>{% endif %}
</main>

<script type="application/json" id="dossier">{{ dossier_json }}</script>
<script type="application/json" id="csv">{{ csv_text }}</script>
<script>
(function(){
const ID = JSON.parse(document.getElementById('dossier').textContent).meta.id, KEY = 'visite-' + ID;
const SLOTS = {{ slots|tojson }};
const state = {champs:{}, photos:[]};
const st = {get(){try{return JSON.parse(localStorage.getItem(KEY)||'null')}catch(e){return null}}, set(v){try{localStorage.setItem(KEY, JSON.stringify(v))}catch(e){}}, del(){try{localStorage.removeItem(KEY)}catch(e){}}};
const frame = document.getElementById('fiche'), wrap = document.getElementById('wrap');
const fdoc = () => frame.contentDocument;

/* ---- onglets ---- */
function show(id){ document.querySelectorAll('nav.tabs button').forEach(b=>b.setAttribute('aria-selected', b.dataset.tab===id));
  document.querySelectorAll('section.tab').forEach(s=>s.classList.toggle('on', s.id==='t-'+id)); window.scrollTo(0,0); if(id==='fiche') fit(); }
document.querySelectorAll('nav.tabs button').forEach(b=>b.onclick=()=>show(b.dataset.tab));
document.querySelectorAll('[data-go]').forEach(b=>b.onclick=()=>show(b.dataset.go));

/* ---- fiche : mise à l'échelle de l'A4 ---- */
function fit(){ const doc=fdoc(); if(!doc||!doc.body) return; const h=doc.documentElement.scrollHeight; frame.style.height=h+'px';
  const W=wrap.parentElement.clientWidth-20, s=Math.min(1,W/794); wrap.style.transform='scale('+s+')'; wrap.style.marginLeft=Math.max(0,(W-794*s)/2)+'px'; wrap.parentElement.style.height=(h*s+20)+'px'; }
frame.addEventListener('load', ()=>{ const doc=fdoc(); const css=doc.createElement('style'); css.textContent='body{background:#7d8794}.page{margin:0 auto 12px;background:#fff;box-shadow:0 2px 10px rgba(0,0,0,.25)}@media print{body{background:#fff}.page{margin:0;box-shadow:none}}'; doc.head.appendChild(css); applyAll(); fit(); });
window.addEventListener('resize', fit);
document.getElementById('print').onclick=()=>frame.contentWindow.print();
const sn=document.getElementById('showNote'); if(sn) sn.onclick=()=>{const b=document.getElementById('noteBody'); b.hidden=!b.hidden; sn.textContent=b.hidden?'Afficher la note':'Masquer la note';};
const ficheHTML=()=>'<!doctype html>'+fdoc().documentElement.outerHTML;
document.getElementById('open').onclick=()=>window.open(URL.createObjectURL(new Blob([ficheHTML()],{type:'text/html'})),'_blank');

/* ---- visite ---- */
function fmtDate(v){ if(!v) return ''; const [d,t]=v.split('T'); const [y,m,j]=d.split('-'); return j+'/'+m+'/'+y+(t?' à '+t:''); }
function applyPV(k,v){ const doc=fdoc(); if(!doc) return; const c=doc.querySelector('[data-pv="'+k+'"]'); if(c) c.textContent = k==='date'?fmtDate(v):v; }
function applyPhotos(){ const doc=fdoc(); if(!doc) return; const pg=doc.getElementById('photos-page'), g=doc.getElementById('photos-grid'); if(!pg||!g) return;
  const ph=(state.photos||[]).filter(Boolean); g.innerHTML=''; ph.forEach(p=>{ const d=doc.createElement('div'); d.className='ph';
    d.innerHTML='<img style="width:100%;height:52mm;object-fit:cover;display:block"><div class="phc"></div>'; d.querySelector('img').src=p.data; d.querySelector('.phc').textContent=p.legende; g.appendChild(d); });
  pg.style.display = ph.length ? '' : 'none'; fit(); }
function applyAll(){ Object.entries(state.champs).forEach(([k,v])=>{ const el=document.querySelector('[data-k="'+k+'"][data-pv]'); if(el) applyPV(el.dataset.pv, v); }); applyPhotos(); }
function prog(){ const cks=[...document.querySelectorAll('input[type=checkbox][data-k]')]; const p=Math.round(cks.filter(c=>c.checked).length/cks.length*100);
  document.getElementById('prog').style.width=p+'%'; document.getElementById('chipVis').textContent='Visite '+p+' %'; }
function evalCnt(inp){ const s=inp.nextElementSibling, v=inp.value.trim(); if(!v){s.className='st na';s.textContent='—';return}
  const ok=Number(v.replace(/\s/g,''))===Number(String(inp.dataset.att).replace(/\s/g,'')); s.className='st '+(ok?'ok':'ko'); s.textContent=ok?'Conforme':'Écart'; }
const save=()=>{ st.set(state); prog(); };
document.querySelectorAll('[data-k]').forEach(el=>{ const k=el.dataset.k, ev=el.type==='checkbox'?'change':'input';
  el.addEventListener(ev,()=>{ state.champs[k]=el.type==='checkbox'?el.checked:el.value; if(k.startsWith('cnt')) evalCnt(el); if(el.dataset.pv) applyPV(el.dataset.pv, el.value); save(); }); });
function shrink(file){ return new Promise(res=>{ const img=new Image(), u=URL.createObjectURL(file); img.onload=()=>{ const m=1280, s=Math.min(1,m/Math.max(img.width,img.height));
  const c=document.createElement('canvas'); c.width=img.width*s; c.height=img.height*s; c.getContext('2d').drawImage(img,0,0,c.width,c.height); URL.revokeObjectURL(u); res(c.toDataURL('image/jpeg',.72)); }; img.src=u; }); }
function showPhoto(i,data){ const sl=document.querySelector('.slot[data-i="'+i+'"]'); let im=sl.querySelector('img'); if(!im){ im=document.createElement('img'); im.alt=SLOTS[i]; sl.prepend(im); } im.src=data; }
document.querySelectorAll('.slot input').forEach(inp=>inp.addEventListener('change', async()=>{ const i=+inp.parentElement.dataset.i; if(!inp.files[0]) return;
  const data=await shrink(inp.files[0]); state.photos[i]={legende:SLOTS[i], data}; showPhoto(i,data); applyPhotos(); save(); }));
const saved=st.get(); if(saved){ Object.assign(state,saved); document.querySelectorAll('[data-k]').forEach(el=>{ const v=state.champs[el.dataset.k]; if(v===undefined) return;
  if(el.type==='checkbox') el.checked=v; else el.value=v; if(el.dataset.k.startsWith('cnt')) evalCnt(el); }); (state.photos||[]).forEach((p,i)=>p&&showPhoto(i,p.data)); }
prog();
document.getElementById('reset').onclick=()=>{ if(confirm('Effacer toutes les saisies de cette visite ?')){ st.del(); location.reload(); } };

/* ---- téléchargements ---- */
function dl(name, text, type){ const a=document.createElement('a'); a.href=URL.createObjectURL(new Blob([text],{type})); a.download=name; document.body.appendChild(a); a.click(); a.remove(); }
function visiteJSON(){ const c=state.champs; return JSON.stringify({dossier:ID, exporte_le:new Date().toISOString(),
  constatations:{date:fmtDate(c.date||''),scelle:c.scelle||'',comptage:c.comptage||'',etiquettes:c.etiquettes||'',pesee:c.pesee||'',echantillons:c.echantillons||'',observations:c.observations||''},
  checklist:Object.fromEntries(Object.entries(c).filter(([k])=>k.startsWith('ck'))), comptages:Object.fromEntries(Object.entries(c).filter(([k])=>k.startsWith('cnt'))),
  photos:(state.photos||[]).filter(Boolean)}); }
document.querySelectorAll('[data-dl]').forEach(b=>b.onclick=()=>{ const t=b.dataset.dl;
  if(t==='dossier') dl('dossier_'+ID+'.json', document.getElementById('dossier').textContent, 'application/json');
  if(t==='csv') dl('registre.csv', '﻿'+JSON.parse(document.getElementById('csv').textContent), 'text/csv');
  if(t==='visite') dl('visite_'+ID+'.json', visiteJSON(), 'application/json');
  if(t==='fiche') dl('fiche_'+ID+'.html', ficheHTML(), 'text/html'); });
})();
</script>
</body>
</html>
